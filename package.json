{
  "name": "idiom-vocab-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Automated English idiom & vocabulary content bot - generates, renders, and posts branded infographics 3x daily via Render + GitHub Actions.",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --dns-result-order=ipv4first --no-network-family-autoselection src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --dns-result-order=ipv4first --no-network-family-autoselection dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.5.0",
    "mongoose": "^9.9.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
