# ===== Server =====
NODE_ENV=development
PORT=3000

# ===== Database (MongoDB Atlas, free M0 tier) =====
MONGODB_URI=<mongodb+srv://user:password@cluster.mongodb.net/idiom-vocab-bot>

# ===== Content generation (Groq) =====
GROQ_API_KEY=<groq api key>

# ===== Image storage (Cloudinary) =====
CLOUDINARY_CLOUD_NAME=<cloudinary cloud name>
CLOUDINARY_API_KEY=<cloudinary api key>
CLOUDINARY_API_SECRET=<cloudinary api secret>

# ===== Publishing (target website) =====
# Dev environment base: https://backend.dev.abstechconnect.com/api/v1
# Production base will be provided later (https://backend.abstechconnect.com/api/v1)
SITE_POST_ENDPOINT=https://backend.dev.abstechconnect.com/api/v1/create-quill-post-new
SITE_API_KEY=<bearer token / api key the website expects for auth>

# ===== Trigger protection (this service) =====
# Required on every POST /run-batch as:  Authorization: Bearer <TRIGGER_AUTH_TOKEN>
TRIGGER_AUTH_TOKEN=<a secret this service requires on /run-batch>

# ===== Content pacing =====
# How many words to use per letter before advancing to the next letter.
WORDS_PER_LETTER=5

# ===== Email notifications (Brevo) =====
# Sends a summary email after each slot finishes. Leave BREVO_API_KEY empty
# to disable notifications.
BREVO_API_KEY=<brevo v3 smtp api key>
BREVO_EMAIL=<verified sender email on brevo>
NOTIFY_EMAIL=ilesanmierioluwavict********
