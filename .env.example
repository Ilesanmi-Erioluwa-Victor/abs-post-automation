NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Africa/Lagos

DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=word-canvas

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=replace_me
EMAIL_FROM=automation@yourdomain.com
EMAIL_TO=you@example.com

POST_PROVIDER_NAME=abs-tech-connect
POST_PROVIDER_ENDPOINT=https://backend.abstechconnect.com/api/v1/create-quill-post-new
POST_PROVIDER_TOKEN=replace_me
POST_PROVIDER_VISIBILITY_TYPE=Everyone
POST_RETRY_LIMIT=5

SESSION_MORNING_HOUR=8
SESSION_AFTERNOON_HOUR=14
SESSION_EVENING_HOUR=20
SESSION_POST_LIMIT=6
SESSION_POST_INTERVAL_MINUTES=12
POST_BATCH_LIMIT=6
CANVAS_WIDTH=1080
CANVAS_HEIGHT=1350
