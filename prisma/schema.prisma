generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LexiconStatus {
  PENDING
  RENDERING
  RENDERED
  SCHEDULED
  POSTED
  FAILED_RENDER
  FAILED_POST
}

enum SessionType {
  MORNING
  AFTERNOON
  EVENING
}

enum SessionStatus {
  QUEUED
  PLANNED
  RUNNING
  COMPLETED
  NEEDS_ATTENTION
}

enum PostJobStatus {
  QUEUED
  POSTING
  POSTED
  RETRY_WAIT
  FAILED_PERMANENT
}

model LexiconEntry {
  id              Int            @id @default(autoincrement())
  sequenceNo      Int            @unique
  letter          String
  word            String         @unique
  partOfSpeech    String
  meaning         String
  exampleSentence String
  status          LexiconStatus  @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  canvasAsset     CanvasAsset?
  postJobs        PostJob[]
}

model CanvasAsset {
  id             Int          @id @default(autoincrement())
  lexiconEntryId Int          @unique
  lexiconEntry   LexiconEntry @relation(fields: [lexiconEntryId], references: [id], onDelete: Cascade)
  storagePath    String
  publicUrl      String?
  checksum       String?
  width          Int
  height         Int
  templateName   String       @default("storm-card")
  renderedAt     DateTime     @default(now())
  postJobs       PostJob[]
}

model PostSession {
  id               Int           @id @default(autoincrement())
  sessionDate      DateTime      @db.Date
  sessionType      SessionType
  plannedCount     Int           @default(0)
  postedCount      Int           @default(0)
  failedCount      Int           @default(0)
  status           SessionStatus @default(QUEUED)
  startedAt        DateTime?
  finishedAt       DateTime?
  summaryEmailedAt DateTime?
  createdAt        DateTime      @default(now())
  postJobs         PostJob[]

  @@unique([sessionDate, sessionType])
}

model PostJob {
  id               Int           @id @default(autoincrement())
  sessionId        Int
  lexiconEntryId   Int           @unique
  canvasAssetId    Int
  provider         String
  scheduledFor     DateTime
  attemptCount     Int           @default(0)
  nextRetryAt      DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  providerPostId   String?
  status           PostJobStatus @default(QUEUED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  session          PostSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lexiconEntry     LexiconEntry  @relation(fields: [lexiconEntryId], references: [id], onDelete: Restrict)
  canvasAsset      CanvasAsset   @relation(fields: [canvasAssetId], references: [id], onDelete: Restrict)
  attempts         PostAttempt[]

  @@index([status, scheduledFor])
  @@index([status, nextRetryAt])
}

model PostAttempt {
  id              Int       @id @default(autoincrement())
  postJobId       Int
  attemptNo       Int
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  success         Boolean   @default(false)
  httpStatus      Int?
  responseExcerpt String?
  errorMessage    String?
  postJob         PostJob   @relation(fields: [postJobId], references: [id], onDelete: Cascade)
}

model SystemCursor {
  key        String   @id
  sequenceNo Int
  updatedAt  DateTime @updatedAt
}
